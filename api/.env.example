# Runtime mode; development enables reload/local CORS while production enables JSON logs and worker processes.
ENVIRONMENT=development
# Python log level used by application and uvicorn logging.
LOG_LEVEL=INFO
# Port read when the API is launched with `python main.py`.
PORT=8000
# Primary uvicorn worker count outside development; rate limits are divided by this value.
WORKERS=1
# Fallback worker count when WORKERS is unset.
WEB_CONCURRENCY=1
# Enable SlowAPI limits on public endpoints; set false only for controlled testing.
RATE_LIMIT_ENABLED=true

# Supabase project/PostgREST origin; replace with your project URL.
SUPABASE_URL=https://your-project.supabase.co
# Supabase service-role key used only by the API; never expose this to the browser.
SUPABASE_SERVICE_API_KEY=replace-with-your-service-role-key
# Long HS256 secret used to verify organizer JWTs and mint dev/demo tokens.
SUPABASE_JWT_SECRET=replace-with-a-long-random-hs256-secret
# Separate secret for speaker, reviewer, and submitter session cookies; falls back to SUPABASE_JWT_SECRET when blank.
PORTAL_SESSION_SECRET=replace-with-a-separate-long-random-secret

# Explicit comma-separated browser origins; wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public web-app origin used in magic links and as an OAuth-origin fallback.
FRONTEND_URL=http://localhost:5173
# Canonical public web origin for MCP OAuth discovery, issuer metadata, and redirects.
PUBLIC_APP_URL=http://localhost:5173
# Public origin of this API service used for absolute calendar-invite links.
PUBLIC_API_URL=http://localhost:8000

# Resend API key; leave blank to write local .eml files instead of sending.
RESEND_API_KEY=
# Display name used in the From header.
MAIL_FROM_NAME=SpeakerWeave
# Verified sender address for outbound mail; replace before enabling Resend.
MAIL_FROM_EMAIL=speakers@example.org
# Calendar ORGANIZER address; falls back to MAIL_FROM_EMAIL when blank.
INVITE_ORGANIZER_EMAIL=organizer@example.org
# Directory for local .eml output; relative paths resolve inside api/.
OUTBOX_DIR=outbox_dev
# Start the in-process database outbox drain loop.
OUTBOX_WORKER_ENABLED=0
# Queue automatic overdue-task reminders during worker sweeps.
AUTO_REMINDERS_ENABLED=1
# Minimum number of hours between overdue-task reminder sweeps.
AUTO_REMINDERS_INTERVAL_HOURS=6

# Airtable personal access token fallback for org_dev only; leave blank for per-org Settings configuration.
AIRTABLE_API_KEY=
# Airtable base ID fallback for org_dev only; leave blank for per-org Settings configuration.
AIRTABLE_BASE_ID=

# Slack request-signature secret from the installed app; leave blank to disable verified events.
SLACK_SIGNING_SECRET=
# Slack bot OAuth token used to post replies; leave blank to disable posting.
SLACK_BOT_TOKEN=
# Organization receiving Slack events until workspace-specific installations are implemented.
SLACK_DEFAULT_ORG=org_dev
# Anthropic key for AI triage and Slack answers; leave blank for heuristic triage/configuration responses.
ANTHROPIC_API_KEY=
