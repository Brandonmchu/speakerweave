# dais api — copy to .env and fill in.

ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_API_KEY=
# Project Settings -> API -> JWT Secret. Signs the tokens the API accepts
# (scripts/mint_dev_token.py today, Clerk's `supabase` JWT template later).
SUPABASE_JWT_SECRET=

# Optional. Unset = per-environment defaults (localhost:5173 in dev).
# Explicit CSV list; "*" is rejected.
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=http://localhost:5173

# Public base URL of THIS api. Calendar invites embed absolute .ics links, so
# a localhost value in production means dead links inside someone's calendar.
PUBLIC_API_URL=http://localhost:8000

# ── email / calendar invites ───────────────────────────────────────────────
# Unset = dev mode: nothing is sent, each message is written to outbox_dev/
# as a .eml you can open in Mail or drag into a client to verify rendering.
RESEND_API_KEY=
MAIL_FROM_EMAIL=invites@dais.events
MAIL_FROM_NAME=dais
# ORGANIZER on the invite. Falls back to MAIL_FROM_EMAIL; an event can override
# it per-event via events.settings.organizer_email.
INVITE_ORGANIZER_EMAIL=
# Where dev-mode .eml files land (relative paths resolve against api/).
OUTBOX_DIR=outbox_dev

# Background delivery and automatic overdue-task reminders. Reminders default
# on whenever the outbox worker is enabled and sweep at most every six hours.
OUTBOX_WORKER_ENABLED=0
AUTO_REMINDERS_ENABLED=1
AUTO_REMINDERS_INTERVAL_HOURS=6

# ── Airtable sync (optional demo-org fallback) ─────────────────────────────
# Production organizers save their own token/base from Settings. These values
# are used only for org_dev when no org_integrations row exists.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ── Slack agent bot ────────────────────────────────────────────────────────
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Temporary workspace binding until installs are stored per workspace.
SLACK_DEFAULT_ORG=org_dev
ANTHROPIC_API_KEY=
