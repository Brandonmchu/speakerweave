# Backend origin baked into the bundle at BUILD time (Vite, not runtime).
#
# Leave empty for same-origin: Vite proxies /api and /public to
# http://localhost:8000 in dev, and nginx proxies them to $BACKEND_URL in prod.
# Set it only when the web app is served from a different origin than the API.
VITE_BACKEND_URL=

# Dev-only override for the Vite proxy target (defaults to http://localhost:8000).
# VITE_API_TARGET=http://localhost:8000
