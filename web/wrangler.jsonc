{
  // Cloudflare Workers deployment of the SpeakerWeave web tier.
  // Build first (npm run build), then: npx wrangler deploy
  "name": "speakerweave-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    // The FastAPI origin (scheme + host, no trailing slash) — same contract
    // as the nginx image's BACKEND_URL.
    "BACKEND_URL": "https://api-production-77b2.up.railway.app"
  },
  "observability": {
    "enabled": true
  }
}
